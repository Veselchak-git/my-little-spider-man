<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>My Little Spider-Man</title>
    <organization>com.veselchak</organization>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options
        customize="never"
        require-scripts="true"
        rootVolumeOnly="true"
        hostArchitectures="arm64"/>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <license file="License.html" mime-type="text/html"/>
    <conclusion file="Conclusion.html" mime-type="text/html"/>
    <pkg-ref id="com.veselchak.my-little-spider-man"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="My Little Spider-Man" description="Desktop spider companion">
        <pkg-ref id="com.veselchak.my-little-spider-man"/>
    </choice>
    <pkg-ref
        id="com.veselchak.my-little-spider-man"
        version="VERSION_PLACEHOLDER"
        onConclusion="none">MyLittleSpiderMan-component.pkg</pkg-ref>
</installer-gui-script>
